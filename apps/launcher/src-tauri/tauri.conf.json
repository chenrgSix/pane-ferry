{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "窗渡 PaneFerry",
  "version": "0.1.1",
  "identifier": "io.lanremoteapp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "窗渡 PaneFerry",
        "width": 1080,
        "height": 760,
        "minWidth": 780,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "resources/PaneFerryWindowHost.app": "PaneFerryWindowHost.app",
      "resources/PaneFerryNode.app": "PaneFerryNode.app",
      "resources/paneferry-network": "paneferry-network"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
