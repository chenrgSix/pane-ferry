[Unit]
Description=LAN RemoteApp user agent
After=default.target
[Service]
Type=simple
ExecStart=%h/.local/bin/remoteapp-agent serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
# Do not use PrivateTmp: X11 clients need the same Unix socket namespace.
[Install]
WantedBy=default.target
