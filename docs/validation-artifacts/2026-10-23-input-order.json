  "causes": [
    {
      "layer": "GNOME IBus asynchronous key filter",
      "evidence": "At the text commit, three filtering callbacks were still pending; Ctrl reached wl_keyboard before the commit but A reached it afterwards. EIS ping/stage-after-update were not completion barriers for IBus.",
      "logs": [
        "paneferry-input-ibus-trace.log",
        "paneferry-input-fixture-current.log"
      ]
    },
    {
      "layer": "GTK application event queue",
      "evidence": "With the filter-completion fix alone, cycle 60 failed although all wl_keyboard events preceded commit_string on the wire. GDK queued key events while the text-input callback applied text immediately in the same read batch.",
      "logs": [
        "paneferry-input-fixed-stress-trace.log",
        "paneferry-input-fixture-fixed.log"
      ]
    }
  ],
  "implementation": {
    "bridge_version": 4,
    "agent_refuses_older_bridge": true,
    "filters": "Observe original IBus callbacks, results and errors through InjectionManager; wait for all preceding callbacks, without changing key meanings. Observe raw filtering and notify_key_event forwarding to mark application state fences.",
    "application": "Wait for a newer surrounding-text-set notification before committing after a key and again after committing. Count notification epochs without reading or retaining text contents.",
    "timeouts": {
      "seconds": 1,
      "before_delivery": "wayland_text_unavailable; no commit is sent",
      "after_delivery": "wayland_text_outcome_unknown; commit might have applied; no retry and later text is blocked until an application acknowledgement arrives"
    },
    "lifecycle": "Reject pending waits, cancel timers and restore observed methods on disable.",
    "mac_ui": "A scoped nonmodal warning preserves the session/window and unrelated windows; no automatic replay."
  },
  "controlled_comparisons": [
